{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "shared/**/*.ts",
    "main/**/*.ts",
    "worker/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
